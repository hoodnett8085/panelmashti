{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "panelmashti",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0124b38f-b645-4466-89d1-8c8734b9dbb1","database_name": "panelmashti" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "956205a9915c4ac2aad8b75ffb8c7408" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
